    <Text size="sm" c="dimmed">R$ {meta.valor_atual} de R$ {meta.valor_alvo}</Text>
    <Text size="sm" fw={500}>{Math.round((meta.valor_atual / meta.valor_alvo) * 100)}%</Text>
  </Group>

  {meta.data_limite && (
    <Text size="xs" c="dimmed" mt="xs">Prazo: {formatDate(meta.data_limite)}</Text>
  )}

  <Group mt="md">
    <Button size="xs" variant="light" onClick={() => abrirAdicionarValor(meta)}>
      + Adicionar valor
    </Button>
    <ActionIcon variant="subtle" color="red" onClick={() => excluirMeta(meta.id)}>
      <IconTrash size={16} />
    </ActionIcon>
  </Group>
</Card>
```

